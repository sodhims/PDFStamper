@page "/"
@using System.IO
@using PdfSharpCore.Pdf
@using PdfSharpCore.Pdf.IO
@using PdfSharpCore.Drawing
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>PDF Stamper</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>PDF Stamper Tool</h1>
        <div>
            <button class="btn btn-outline-primary" @onclick="ToggleSettings">
                <span>⚙️ Manage Phrases</span>
            </button>
            <button class="btn btn-outline-success ms-2" @onclick="ToggleStampPresets">
                <span>💾 Stamp Presets</span>
            </button>
        </div>
    </div>
    @if (showStampPresets)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Save & Load Stamp Settings</h5>
                
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" class="form-control" @bind="newPresetName" placeholder="Enter preset name (e.g., 'Confidential Red Top Right')" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success w-100" @onclick="SaveCurrentSettings">Save Current Settings</button>
                    </div>
                </div>
                
                <h6>Saved Presets:</h6>
                <div class="list-group">
                    @foreach (var preset in stampPresets)
                    {
						<div class="list-group-item d-flex justify-content-between align-items-center">
							<span>
								<strong>@preset.Name</strong>
									<small class="text-muted d-block">
										@if (!string.IsNullOrEmpty(preset.Text) && preset.StampMode != "ImageOnly")
										{
											@preset.Text <text> - </text>
										}
										@preset.Position (@preset.Color, @preset.FontSize pt)
										@if (!string.IsNullOrEmpty(preset.ImageBase64))
										{
											<span class="badge bg-info ms-2">📷 @preset.ImageName</span>
										}
										@if (preset.StampMode == "ImageOnly")
										{
											<span class="badge bg-success ms-2">Image Only</span>
										}
										else if (preset.StampMode == "Both")
										{
											<span class="badge bg-primary ms-2">Image + Text</span>
										}
									</small>
							</span>
							<div>
								<button class="btn btn-sm btn-primary me-2" @onclick="() => LoadPreset(preset)">Load</button>
								<button class="btn btn-sm btn-danger" @onclick="() => RemovePreset(preset)">Delete</button>
							</div>
						</div>
                    }
                </div>
                
                @if (!stampPresets.Any())
                {
                    <p class="text-muted mt-2">No saved presets. Save your current settings above!</p>
                }
            </div>
        </div>
    }
    
    @if (showSettings)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Stamp Phrase Management</h5>
                
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" class="form-control" @bind="newPhrase" placeholder="Enter new phrase" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success w-100" @onclick="AddPhrase">Add Phrase</button>
                    </div>
                </div>
                
                <h6>Saved Phrases:</h6>
                <div class="list-group">
                    @foreach (var phrase in stampPhrases)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@phrase</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemovePhrase(phrase)">Remove</button>
                        </div>
                    }
                </div>
                
                @if (!stampPhrases.Any())
                {
                    <p class="text-muted mt-2">No saved phrases. Add some above!</p>
                }
            </div>
        </div>
    }
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Upload PDF(s)</h5>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="batchMode" id="batchMode">
                            <label class="form-check-label" for="batchMode">
                                <strong>Batch Mode</strong> - Process multiple PDFs at once
                            </label>
                        </div>
                    </div>
                    
                    @if (batchMode)
                    {
                        <InputFile OnChange="HandleBatchFileSelected" class="form-control" accept=".pdf" multiple />
                        <small class="text-muted">Select multiple PDF files to stamp them all with the same settings</small>
                    }
                    else
                    {
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf" />
                        <small class="text-muted">Select a single PDF file</small>
                    }
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                    
                    @if (batchMode && batchFiles.Any())
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Batch Mode: @batchFiles.Count file(s) loaded</strong>
                            <div class="mt-2">
                                <strong>Current File: @(currentBatchIndex + 1) / @batchFiles.Count</strong>
                                <div class="progress mt-2" style="height: 25px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: @((currentBatchIndex) * 100.0 / batchFiles.Count)%">
                                        @currentBatchIndex of @batchFiles.Count completed
                                    </div>
                                </div>
                            </div>
                            <div class="list-group mt-3" style="max-height: 200px; overflow-y: auto;">
                                @for (int i = 0; i < batchFiles.Count; i++)
                                {
                                    var index = i;
                                    var file = batchFiles[i];
                                    var status = file.StampedBytes != null ? "✓ Completed" : 
                                                 index == currentBatchIndex ? "→ Current" : "⋯ Pending";
                                    var cssClass = file.StampedBytes != null ? "list-group-item-success" : 
                                                   index == currentBatchIndex ? "list-group-item-primary" : "";
                                    
                                    <div class="list-group-item @cssClass">
                                        <strong>@(index + 1).</strong> @file.Name (@file.PageCount page(s)) - <em>@status</em>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (pdfLoaded)
                    {
                        <div class="alert alert-success mt-3">
                            PDF loaded successfully! (@pageCount page(s))
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            @if (pdfLoaded || batchFiles.Any())
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Stamp Settings</h5>
                        
                        <!-- Stamp Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">What to Stamp</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="stampType" id="textOnly" 
                                       checked="@(stampMode == "TextOnly")" @onchange='() => stampMode = "TextOnly"'>
                                <label class="form-check-label" for="textOnly">
                                    Text Only
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="stampType" id="imageOnly" 
                                       checked="@(stampMode == "ImageOnly")" @onchange='() => stampMode = "ImageOnly"'>
                                <label class="form-check-label" for="imageOnly">
                                    Image Only
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="stampType" id="both" 
                                       checked="@(stampMode == "Both")" @onchange='() => stampMode = "Both"'>
                                <label class="form-check-label" for="both">
                                    Both Image and Text
                                </label>
                            </div>
                        </div>

                        <!-- TEXT SETTINGS -->
                        @if (stampMode == "TextOnly" || stampMode == "Both")
                        {
                            <div class="card mb-3 bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Text Settings</h6>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Stamp Text (use \n for new lines)</label>
                                        <select class="form-select mb-2" @bind="stampText">
                                            <option value="">-- Select a phrase --</option>
                                            @foreach (var phrase in stampPhrases)
                                            {
                                                <option value="@phrase">@phrase</option>
                                            }
                                        </select>
                                        <textarea class="form-control" rows="3" @bind="stampText" placeholder="Or enter custom text (use \n for line breaks)"></textarea>
                                        <small class="text-muted">Example: CONFIDENTIAL\nDO NOT COPY</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Add Symbol</label>
                                        <select class="form-select" @bind="selectedSymbol">
                                            <option value="">-- No Symbol --</option>
                                            <option value="[X]">[X] Checkmark</option>
                                            <option value="[!]">[!] Alert/Warning</option>
                                            <option value="[*]">[*] Star/Important</option>
                                            <option value="[APPROVED]">[APPROVED]</option>
                                            <option value="[CONFIDENTIAL]">[CONFIDENTIAL]</option>
                                            <option value="[DRAFT]">[DRAFT]</option>
                                            <option value="[URGENT]">[URGENT]</option>
                                            <option value="[COPY]">[COPY]</option>
                                        </select>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(selectedSymbol))
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">Symbol Position</label>
                                            <select class="form-select" @bind="symbolPosition">
                                                <option value="Before">Before Text</option>
                                                <option value="After">After Text</option>
                                                <option value="Above">Above Text</option>
                                                <option value="Below">Below Text</option>
                                            </select>
                                        </div>
                                    }

                                    <div class="mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="includeDateTimeStamp" id="includeDateTimeStamp">
                                            <label class="form-check-label" for="includeDateTimeStamp">
                                                Include Date/Time Stamp
                                            </label>
                                        </div>
                                    </div>

                                    @if (includeDateTimeStamp)
                                    {
                                        <div class="border-start border-3 border-primary ps-3 mb-3">
                                            <div class="mb-2">
                                                <label class="form-label">Format</label>
                                                <select class="form-select form-select-sm" @bind="dateTimeFormat">
                                                    <option value="yyyy-MM-dd HH:mm:ss">2025-01-15 14:30:45</option>
                                                    <option value="MM/dd/yyyy hh:mm tt">01/15/2025 02:30 PM</option>
                                                    <option value="dd/MM/yyyy HH:mm">15/01/2025 14:30</option>
                                                    <option value="yyyy-MM-dd">2025-01-15 (Date Only)</option>
                                                </select>
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label">Position</label>
                                                <select class="form-select form-select-sm" @bind="dateTimePosition">
                                                    <option value="Above">Above main text</option>
                                                    <option value="Below">Below main text</option>
                                                    <option value="Replace">Replace main text</option>
                                                </select>
                                            </div>
                                        </div>
                                    }

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Font Family</label>
                                            <select class="form-select" @bind="fontFamily">
                                                <option value="Arial">Arial</option>
                                                <option value="Times New Roman">Times New Roman</option>
                                                <option value="Courier New">Courier New</option>
                                                <option value="Verdana">Verdana</option>
                                                <option value="Georgia">Georgia</option>
                                                <option value="Impact">Impact</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Font Size</label>
                                            <input type="number" class="form-control" @bind="fontSize" min="8" max="72" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Color</label>
                                            <select class="form-select" @bind="stampColor">
                                                <option value="Red">Red</option>
                                                <option value="Blue">Blue</option>
                                                <option value="Green">Green</option>
                                                <option value="Black">Black</option>
                                                <option value="Gray">Gray</option>
                                                <option value="Orange">Orange</option>
                                                <option value="Purple">Purple</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Opacity</label>
                                            <input type="range" class="form-range" @bind="stampOpacity" @bind:event="oninput" min="10" max="100" step="5" />
                                            <small class="text-muted">@stampOpacity%</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- IMAGE SETTINGS -->
                        @if (stampMode == "ImageOnly" || stampMode == "Both")
                        {
                            <div class="card mb-3 bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Image Settings</h6>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Upload Image</label>
                                        <InputFile OnChange="HandleImageSelected" class="form-control" accept=".png,.jpg,.jpeg" />
                                        @if (stampImageBytes != null)
                                        {
                                            <div class="mt-2">
                                                <small class="text-success">Loaded: @stampImageName</small>
                                                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="ClearImage">Remove</button>
                                            </div>
                                        }
                                        <small class="text-muted d-block">PNG, JPG, or JPEG (max 5MB)</small>
                                    </div>
                                    
                                    @if (stampImageBytes != null)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">Image Size</label>
                                            <input type="range" class="form-range" @bind="imageWidth" @bind:event="oninput" min="50" max="300" />
                                            <small class="text-muted">Width: @imageWidth px</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- POSITION & STYLING -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Position & Style</h6>
                                
                                <div class="mb-3">
                                    <label class="form-label">Position</label>
                                    <div class="position-selector" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; max-width: 300px; margin-bottom: 10px;">
                                        <button type="button" class="btn btn-sm @(stampPosition == "TopLeft" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopLeft"'>TL</button>
                                        <button type="button" class="btn btn-sm @(stampPosition == "TopCenter" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopCenter"'>TC</button>
                                        <button type="button" class="btn btn-sm @(stampPosition == "TopRight" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopRight"'>TR</button>
                                        <button type="button" class="btn btn-sm @(stampPosition == "BottomLeft" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "BottomLeft"'>BL</button>
                                        <button type="button" class="btn btn-sm @(stampPosition == "Center" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "Center"'>C</button>
                                        <button type="button" class="btn btn-sm @(stampPosition == "BottomRight" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "BottomRight"'>BR</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Rotation</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RotateCounterClockwise">↶ -45°</button>
                                        <strong>@textRotation°</strong>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RotateClockwise">↷ +45°</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ResetRotation">Reset</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="showBorder" id="showBorder">
                                        <label class="form-check-label" for="showBorder">
                                            Add Border/Effects
                                        </label>
                                    </div>
                                </div>

                                @if (showBorder)
                                {
                                    <div class="border-start border-3 border-secondary ps-3">
                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <label class="form-label">Style</label>
                                                <select class="form-select form-select-sm" @bind="borderStyle">
                                                    <option value="Single">Single</option>
                                                    <option value="Double">Double</option>
                                                    <option value="Rounded">Rounded</option>
                                                    <option value="Shadow">Shadow</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <label class="form-label">Color</label>
                                                <select class="form-select form-select-sm" @bind="borderColor">
                                                    <option value="Red">Red</option>
                                                    <option value="Blue">Blue</option>
                                                    <option value="Black">Black</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- PAGE OPTIONS -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Page Options</h6>
                                
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" @bind="stampAllPages" id="stampAllPages">
                                        <label class="form-check-label" for="stampAllPages">
                                            Stamp all pages
                                        </label>
                                    </div>
                                </div>
                                
                                @if (!stampAllPages)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Page Number (1-@pageCount)</label>
                                        <input type="number" class="form-control" @bind="pageNumber" min="1" max="@pageCount" />
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- ACTION BUTTONS -->
                        <div class="btn-toolbar gap-2 mt-3" role="toolbar">
                            @if (batchMode)
                            {
                                <button class="btn btn-primary" @onclick="StampPdf" disabled="@(isProcessing || currentBatchIndex >= batchFiles.Count)">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Stamp Current File
                                </button>
                                
                                <button class="btn btn-warning" @onclick="StampAllFiles" disabled="@(isProcessing || !batchFiles.Any())">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Stamp All Files
                                </button>
                                
                                <button class="btn btn-success" @onclick="DownloadCurrentFile" disabled="@(currentBatchFile?.StampedBytes == null)">
                                    Download Current
                                </button>
                                
                                <button class="btn btn-info" @onclick="NextFile" disabled="@(currentBatchIndex >= batchFiles.Count - 1)">
                                    Next File →
                                </button>
                                
                                @if (batchFiles.All(f => f.StampedBytes != null))
                                {
                                    <button class="btn btn-success" @onclick="DownloadAsZip">
                                        Download as ZIP
                                    </button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="StampPdf" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    Stamp PDF
                                </button>

                                @if (stampedPdfBytes != null)
                                {
                                    <button class="btn btn-success" @onclick="DownloadStampedPdf">
                                        Download Stamped PDF
                                    </button>
                                    <button class="btn btn-info" @onclick="ToggleStampPresets">
                                        Save Settings
                                    </button>
                                }
                            }
                        </div>
                        
                    </div>
                </div>
            }
        </div>
        
        <div class="col-md-6">
            @if (batchMode && batchFiles.Any())
            {
                <div class="card">
                    <div class="card-body">
                        @if (currentBatchFile != null)
                        {
                            <h5 class="card-title">Current File: @currentBatchFile.Name</h5>
                            <p class="text-muted">File @(currentBatchIndex + 1) of @batchFiles.Count (@currentBatchFile.PageCount page(s))</p>
                            
                            @if (currentBatchFile.StampedBytes != null)
                            {
                                <h6>Stamped Preview</h6>
                                <iframe src="@(GetPdfDataUrl(currentBatchFile.StampedBytes))" 
                                        style="width: 100%; height: 350px; border: 1px solid #ddd;">
                                </iframe>
                            }
                            else
                            {
                                <h6>Original Preview</h6>
                                <iframe src="@(GetPdfDataUrl(currentBatchFile.OriginalBytes))" 
                                        style="width: 100%; height: 350px; border: 1px solid #ddd;">
                                </iframe>
                            }
                        }
                    </div>
                </div>
            }
            else if (!batchMode && pdfLoaded && originalPdfBytes != null)
            {
                <div class="card">
                    <div class="card-body">
                        <h6>Original PDF Preview</h6>
                        <iframe src="@GetPdfDataUrl(originalPdfBytes)" 
                                style="width: 100%; height: 350px; border: 1px solid #ddd;">
                        </iframe>
                    </div>
                </div>
                
                @if (stampedPdfBytes != null)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <h6>Stamped PDF Preview</h6>
                            <iframe src="@GetPdfDataUrl(stampedPdfBytes)" 
                                    style="width: 100%; height: 350px; border: 1px solid #ddd;">
                            </iframe>
                        </div>
                    </div>
                }
            }
            else if (batchMode)
            {
                <div class="alert alert-info">
                    Please select multiple PDF files to begin batch processing.
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Please select a PDF file to begin.
                </div>
            }
            
            @if (pdfLoaded || batchFiles.Any())
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title text-center">Stamp Preview</h6>
                        <div style="min-height: 150px; display: flex; align-items: center; justify-content: center; border: 2px dashed #ccc; border-radius: 5px; padding: 15px; background-color: #f8f9fa; position: relative; overflow: hidden;">
                            <div style="transform: rotate(@(textRotation)deg); display: inline-block; position: relative;">
                                
                                @if (stampImageBytes != null && (stampMode == "ImageOnly" || stampMode == "Both"))
                                {
                                    var imageDataUrl = GetImageDataUrl();
                                    if (!string.IsNullOrEmpty(imageDataUrl))
                                    {
                                        <div style="text-align: center; @(stampMode == "Both" ? "margin-bottom: 10px;" : "")">
                                            <img src="@imageDataUrl" style="max-width: @(imageWidth)px; height: auto;" alt="Stamp image" />
                                        </div>
                                    }
                                }
                                
                                @if (!string.IsNullOrEmpty(stampText) && (stampMode == "TextOnly" || stampMode == "Both"))
                                {
                                    <div style="font-family: @GetPreviewFontFamily(); text-align: center;">
                                        @foreach (var line in GetPreviewLines())
                                        {
                                            var lineStyle = GetPreviewLineStyle(line);
                                            <div style="@lineStyle">@line</div>
                                        }
                                    </div>
                                }
                                
                                @if (showBorder && borderStyle != "Outline" && borderStyle != "Shadow" && borderStyle != "Glow" && borderStyle != "Highlight")
                                {
                                    <div style="position: absolute; top: -@(borderPadding)px; left: -@(borderPadding)px; right: -@(borderPadding)px; bottom: -@(borderPadding)px; border: @(borderWidth)px @(borderStyle == "Dashed" ? "dashed" : "solid") @GetColorCode(borderColor); border-radius: @(borderStyle == "Rounded" ? cornerRadius + "px" : "0"); pointer-events: none;"></div>
