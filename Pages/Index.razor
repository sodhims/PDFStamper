@page "/"
@using System.IO
@using PdfSharpCore.Pdf
@using PdfSharpCore.Pdf.IO
@using PdfSharpCore.Drawing
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>PDF Stamper</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>PDF Stamper Tool</h1>
        <button class="btn btn-outline-primary" @onclick="ToggleSettings">
            <span>⚙️ Manage Phrases</span>
        </button>
    </div>
    
    @if (showSettings)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Stamp Phrase Management</h5>
                
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" class="form-control" @bind="newPhrase" placeholder="Enter new phrase" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success w-100" @onclick="AddPhrase">Add Phrase</button>
                    </div>
                </div>
                
                <h6>Saved Phrases:</h6>
                <div class="list-group">
                    @foreach (var phrase in stampPhrases)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@phrase</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemovePhrase(phrase)">Remove</button>
                        </div>
                    }
                </div>
                
                @if (!stampPhrases.Any())
                {
                    <p class="text-muted mt-2">No saved phrases. Add some above!</p>
                }
            </div>
        </div>
    }
    
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Upload PDF(s)</h5>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="batchMode" id="batchMode">
                            <label class="form-check-label" for="batchMode">
                                <strong>Batch Mode</strong> - Process multiple PDFs at once
                            </label>
                        </div>
                    </div>
                    
                    @if (batchMode)
                    {
                        <InputFile OnChange="HandleBatchFileSelected" class="form-control" accept=".pdf" multiple />
                        <small class="text-muted">Select multiple PDF files to stamp them all with the same settings</small>
                    }
                    else
                    {
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf" />
                        <small class="text-muted">Select a single PDF file</small>
                    }
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">@errorMessage</div>
                    }
                    
                    @if (batchMode && batchFiles.Any())
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Batch Mode: @batchFiles.Count file(s) loaded</strong>
                            <div class="mt-2">
                                <strong>Current File: @(currentBatchIndex + 1) / @batchFiles.Count</strong>
                                <div class="progress mt-2" style="height: 25px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: @((currentBatchIndex) * 100.0 / batchFiles.Count)%">
                                        @currentBatchIndex of @batchFiles.Count completed
                                    </div>
                                </div>
                            </div>
                            <div class="list-group mt-3" style="max-height: 200px; overflow-y: auto;">
                                @for (int i = 0; i < batchFiles.Count; i++)
                                {
                                    var index = i;
                                    var file = batchFiles[i];
                                    var status = file.StampedBytes != null ? "✓ Completed" : 
                                                 index == currentBatchIndex ? "→ Current" : "⋯ Pending";
                                    var cssClass = file.StampedBytes != null ? "list-group-item-success" : 
                                                   index == currentBatchIndex ? "list-group-item-primary" : "";
                                    
                                    <div class="list-group-item @cssClass">
                                        <strong>@(index + 1).</strong> @file.Name (@file.PageCount page(s)) - <em>@status</em>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (pdfLoaded)
                    {
                        <div class="alert alert-success mt-3">
                            PDF loaded successfully! (@pageCount page(s))
                        </div>
                    }
                </div>
            </div>
            
            @if (pdfLoaded || batchFiles.Any())
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Stamp Settings</h5>
                        
                        <div class="mb-3">
                            <label class="form-label">Stamp Text (use \n for new lines)</label>
                            <select class="form-select mb-2" @bind="stampText">
                                <option value="">-- Select a phrase --</option>
                                @foreach (var phrase in stampPhrases)
                                {
                                    <option value="@phrase">@phrase</option>
                                }
                            </select>
                            <textarea class="form-control" rows="3" @bind="stampText" placeholder="Or enter custom text (use \n for line breaks)"></textarea>
                            <small class="text-muted">Example: CONFIDENTIAL\nDO NOT COPY</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Add Symbol</label>
                            <select class="form-select" @bind="selectedSymbol">
                                <option value="">-- No Symbol --</option>
                                <option value="[X]">[X] Checkmark</option>
                                <option value="[!]">[!] Alert/Warning</option>
                                <option value="[*]">[*] Star/Important</option>
                                <option value="[APPROVED]">[APPROVED]</option>
                                <option value="[CONFIDENTIAL]">[CONFIDENTIAL]</option>
                                <option value="[DRAFT]">[DRAFT]</option>
                                <option value="[URGENT]">[URGENT]</option>
                                <option value="[COPY]">[COPY]</option>
                                <option value=">>>">>> Forward Arrows</option>
                                <option value="<<<">&lt;&lt;&lt; Back Arrows</option>
                                <option value="***">*** Stars</option>
                                <option value="==">== Double Line</option>
                                <option value="--">-- Dash Line</option>
                                <option value="###">### Hash Marks</option>
                            </select>
                            <small class="text-muted">Simple text-based symbols</small>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(selectedSymbol))
                        {
                            <div class="mb-3">
                                <label class="form-label">Symbol Position</label>
                                <select class="form-select" @bind="symbolPosition">
                                    <option value="Before">Before Text</option>
                                    <option value="After">After Text</option>
                                    <option value="Above">Above Text</option>
                                    <option value="Below">Below Text</option>
                                </select>
                            </div>
                        }
                        
                        <div class="mb-3">
                            <label class="form-label">Font Family</label>
                            <select class="form-select" @bind="fontFamily">
                                <option value="Arial">Arial</option>
                                <option value="Times New Roman">Times New Roman</option>
                                <option value="Courier New">Courier New</option>
                                <option value="Verdana">Verdana</option>
                                <option value="Georgia">Georgia</option>
                                <option value="Comic Sans MS">Comic Sans MS</option>
                                <option value="Trebuchet MS">Trebuchet MS</option>
                                <option value="Impact">Impact</option>
                                <option value="Tahoma">Tahoma</option>
                                <option value="Palatino Linotype">Palatino Linotype</option>
                                <option value="Lucida Console">Lucida Console</option>
                                <option value="Garamond">Garamond</option>
                                <option value="Bookman Old Style">Bookman Old Style</option>
                                <option value="Arial Black">Arial Black</option>
                                <option value="Calibri">Calibri (Windows)</option>
                                <option value="Cambria">Cambria (Windows)</option>
                                <option value="Consolas">Consolas (Windows)</option>
                                <option value="Segoe UI">Segoe UI (Windows)</option>
                            </select>
                            <small class="text-muted">Note: Some fonts may only work on specific operating systems</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Font Size</label>
                            <input type="number" class="form-control" @bind="fontSize" min="8" max="72" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Position</label>
                            <div class="position-selector" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; max-width: 300px; margin-bottom: 10px;">
                                <button type="button" class="btn btn-sm @(stampPosition == "TopLeft" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopLeft"'>
                                    TL
                                </button>
                                <button type="button" class="btn btn-sm @(stampPosition == "TopCenter" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopCenter"'>
                                    TC
                                </button>
                                <button type="button" class="btn btn-sm @(stampPosition == "TopRight" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "TopRight"'>
                                    TR
                                </button>
                                <button type="button" class="btn btn-sm @(stampPosition == "BottomLeft" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "BottomLeft"'>
                                    BL
                                </button>
                                <button type="button" class="btn btn-sm @(stampPosition == "Center" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "Center"'>
                                    C
                                </button>
                                <button type="button" class="btn btn-sm @(stampPosition == "BottomRight" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => stampPosition = "BottomRight"'>
                                    BR
                                </button>
                            </div>
                            <select class="form-select" @bind="stampPosition">
                                <option value="TopLeft">Top Left</option>
                                <option value="TopCenter">Top Center</option>
                                <option value="TopRight">Top Right</option>
                                <option value="Center">Center</option>
                                <option value="BottomLeft">Bottom Left</option>
                                <option value="BottomCenter">Bottom Center</option>
                                <option value="BottomRight">Bottom Right</option>
                                <option value="Custom">Custom Position...</option>
                            </select>
                        </div>
                        
                        @if (stampPosition == "Custom")
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h6>Custom Position</h6>
                                    <div class="mb-2">
                                        <label class="form-label">X Position (0-100%)</label>
                                        <input type="range" class="form-range" @bind="customX" min="0" max="100" />
                                        <small>@customX%</small>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Y Position (0-100%)</label>
                                        <input type="range" class="form-range" @bind="customY" min="0" max="100" />
                                        <small>@customY%</small>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Rotation (-180° to 180°)</label>
                                        <input type="range" class="form-range" @bind="customRotation" min="-180" max="180" />
                                        <small>@customRotation°</small>
                                    </div>
                                </div>
                            </div>
                        }
                        
						<div class="mb-3">
							<label class="form-label">Text Rotation</label>
							<div class="rotation-selector" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; max-width: 400px; margin-bottom: 10px;">
								<button type="button" class="btn btn-sm @(textRotation == 0 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = 0'>
									0°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == 45 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = 45'>
									45°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == 90 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = 90'>
									90°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == 135 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = 135'>
									135°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == -45 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = -45'>
									-45°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == -90 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = -90'>
									-90°
								</button>
								<button type="button" class="btn btn-sm @(textRotation == -135 ? "btn-primary" : "btn-outline-secondary")" @onclick='() => textRotation = -135'>
									-135°
								</button>
							</div>
							<small class="text-muted">Select rotation angle for stamp text</small>
						</div>                       
                        
                        <div class="mb-3">
                            <label class="form-label">Color</label>
                            <select class="form-select" @bind="stampColor">
                                <option value="Red">Red</option>
                                <option value="Blue">Blue</option>
                                <option value="Green">Green</option>
                                <option value="Black">Black</option>
                                <option value="Gray">Gray</option>
                                <option value="Orange">Orange</option>
                                <option value="Purple">Purple</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Opacity / Transparency</label>
                            <input type="range" class="form-range" @bind="stampOpacity" min="10" max="100" step="5" />
                            <small class="text-muted">@stampOpacity% - @(stampOpacity < 50 ? "Watermark" : stampOpacity < 80 ? "Semi-transparent" : "Solid")</small>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="showBorder" id="showBorder">
                                <label class="form-check-label" for="showBorder">
                                    Show Border/Effects
                                </label>
                            </div>
                        </div>
                        
                        @if (showBorder)
                        {
                            <div class="mb-3">
                                <label class="form-label">Border Style</label>
                                <select class="form-select" @bind="borderStyle">
                                    <option value="Single">Single Line</option>
                                    <option value="Double">Double Line</option>
                                    <option value="Rounded">Rounded Corners</option>
                                    <option value="Outline">Outline Text Only</option>
                                    <option value="Shadow">Drop Shadow</option>
                                    <option value="Glow">Glow Effect</option>
                                    <option value="Highlight">Highlight Background</option>
                                    <option value="Dashed">Dashed Border</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Border Color</label>
                                <select class="form-select" @bind="borderColor">
                                    <option value="Red">Red</option>
                                    <option value="Blue">Blue</option>
                                    <option value="Green">Green</option>
                                    <option value="Black">Black</option>
                                    <option value="Gray">Gray</option>
                                    <option value="Orange">Orange</option>
                                    <option value="Purple">Purple</option>
                                    <option value="Yellow">Yellow</option>
                                    <option value="White">White</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Border Width</label>
                                <input type="number" class="form-control" @bind="borderWidth" min="1" max="10" />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Border Padding</label>
                                <input type="number" class="form-control" @bind="borderPadding" min="5" max="50" />
                            </div>
                            
                            @if (borderStyle == "Rounded")
                            {
                                <div class="mb-3">
                                    <label class="form-label">Corner Radius</label>
                                    <input type="number" class="form-control" @bind="cornerRadius" min="5" max="50" />
                                </div>
                            }
                            
                            @if (borderStyle == "Shadow" || borderStyle == "Glow")
                            {
                                <div class="mb-3">
                                    <label class="form-label">Effect Intensity</label>
                                    <input type="number" class="form-control" @bind="effectIntensity" min="1" max="10" />
                                </div>
                            }
                            
                            @if (borderStyle == "Highlight")
                            {
                                <div class="mb-3">
                                    <label class="form-label">Background Opacity (0-100)</label>
                                    <input type="number" class="form-control" @bind="backgroundOpacity" min="0" max="100" />
                                </div>
                            }
                        }
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="stampAllPages" id="stampAllPages">
                                <label class="form-check-label" for="stampAllPages">
                                    Stamp all pages
                                </label>
                            </div>
                        </div>
                        
                        @if (!stampAllPages)
                        {
                            <div class="mb-3">
                                <label class="form-label">Page Number (1-@pageCount)</label>
                                <input type="number" class="form-control" @bind="pageNumber" min="1" max="@pageCount" />
                            </div>
                        }
                        
                        <div class="mb-3">
                            <label class="form-label">Number of Stamps per Page</label>
                            <select class="form-select" @bind="stampsPerPage">
                                <option value="1">1 Stamp</option>
                                <option value="2">2 Stamps (Mirrored)</option>
                                <option value="3">3 Stamps</option>
                            </select>
                            @if (stampsPerPage == 2)
                            {
                                <small class="text-muted">Second stamp will be mirrored symmetrically across page center</small>
                            }
                        </div>
                        
                        @if (stampsPerPage > 2)
                        {
                            <div class="alert alert-info">
                                <small>
                                    <strong>Multiple Stamps:</strong><br/>
                                    Stamp 1: Current position (@stampPosition)<br/>
                                    <span>
                                        Stamp 2: 
                                        <select class="form-select form-select-sm d-inline-block w-auto" @bind="stamp2Position">
                                            <option value="TopLeft">Top Left</option>
                                            <option value="TopCenter">Top Center</option>
                                            <option value="TopRight">Top Right</option>
                                            <option value="Center">Center</option>
                                            <option value="BottomLeft">Bottom Left</option>
                                            <option value="BottomCenter">Bottom Center</option>
                                            <option value="BottomRight">Bottom Right</option>
                                        </select>
                                        <br/>
                                    </span>
                                    <span>
                                        Stamp 3: 
                                        <select class="form-select form-select-sm d-inline-block w-auto" @bind="stamp3Position">
                                            <option value="TopLeft">Top Left</option>
                                            <option value="TopCenter">Top Center</option>
                                            <option value="TopRight">Top Right</option>
                                            <option value="Center">Center</option>
                                            <option value="BottomLeft">Bottom Left</option>
                                            <option value="BottomCenter">Bottom Center</option>
                                            <option value="BottomRight">Bottom Right</option>
                                        </select>
                                    </span>
                                </small>
                            </div>
                        }
                        
                        @if (batchMode)
                        {
                            <!-- Batch Mode: 3 buttons -->
                            <button class="btn btn-primary" @onclick="StampPdf" disabled="@(isProcessing || currentBatchIndex >= batchFiles.Count)">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Stamp Current File
                            </button>
                            
                            <button class="btn btn-success ms-2" @onclick="DownloadCurrentFile" disabled="@(currentBatchFile?.StampedBytes == null)">
                                Download
                            </button>
                            
                            <button class="btn btn-info ms-2" @onclick="NextFile" disabled="@(currentBatchIndex >= batchFiles.Count - 1)">
                                Next File
                            </button>
                            
                            @if (batchFiles.All(f => f.StampedBytes != null))
                            {
                                <button class="btn btn-warning ms-2" @onclick="DownloadAllCompleted">
                                    Download All (@batchFiles.Count files)
                                </button>
                            }
							@if (batchMode && batchFiles.Any(f => f.StampedBytes != null && !f.Downloaded))
							{
								<div class="alert alert-warning mt-2">
									<small><strong>Note:</strong> When downloading multiple files, your browser may ask for permission. Please click "Allow" when prompted.</small>
								</div>
							}
                        }
                        else
                        {
                            <!-- Single File Mode: 2 buttons -->
                            <button class="btn btn-primary" @onclick="StampPdf" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Stamp PDF
                            </button>

                            @if (stampedPdfBytes != null)
                            {
                                <button class="btn btn-success ms-2" @onclick="DownloadStampedPdf">
                                    Download
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        
        <div class="col-md-6">
            @if (batchMode && currentBatchFile != null)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Current File: @currentBatchFile.Name</h5>
                        <p class="text-muted">File @(currentBatchIndex + 1) of @batchFiles.Count (@currentBatchFile.PageCount page(s))</p>
                        
                        @if (currentBatchFile.StampedBytes != null)
                        {
                            <h6>Stamped Preview</h6>
                            <iframe src="@(GetPdfDataUrl(currentBatchFile.StampedBytes))" 
                                    style="width: 100%; height: 600px; border: 1px solid #ddd;"
                                    key="@($"stamped-{currentBatchIndex}")">
                            </iframe>
                        }
                        else if (currentBatchFile.OriginalBytes != null && currentBatchFile.OriginalBytes.Length > 0)
                        {
                            <h6>Original Preview</h6>
                            <iframe src="@(GetPdfDataUrl(currentBatchFile.OriginalBytes))" 
                                    style="width: 100%; height: 600px; border: 1px solid #ddd;"
                                    key="@($"original-{currentBatchIndex}")">
                            </iframe>
                        }
                        else
                        {
                            <div class="alert alert-warning">No preview available for this file.</div>
                        }
                    </div>
                </div>
            }
            else if (pdfLoaded && originalPdfBytes != null && !batchMode)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Original PDF Preview</h5>
                        <iframe src="@GetPdfDataUrl(originalPdfBytes)" 
                                style="width: 100%; height: 500px; border: 1px solid #ddd;">
                        </iframe>
                    </div>
                </div>
                
                @if (stampedPdfBytes != null)
                {
                    <div class="card mt-3">
                        <div class="card-body">
                            <h5 class="card-title">Stamped PDF Preview</h5>
                            <iframe src="@GetPdfDataUrl(stampedPdfBytes)" 
                                    style="width: 100%; height: 500px; border: 1px solid #ddd;">
                            </iframe>
                        </div>
                    </div>
                }
            }
            else if (batchMode && !batchFiles.Any())
            {
                <div class="alert alert-info">
                    Please select multiple PDF files to begin batch processing.
                </div>
            }
            else if (!batchMode && !pdfLoaded)
            {
                <div class="alert alert-info">
                    Please select a PDF file to begin.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private byte[]? originalPdfBytes;
    private byte[]? stampedPdfBytes;
    private bool pdfLoaded = false;
    private int pageCount = 0;
    private string errorMessage = string.Empty;
    private bool isProcessing = false;
    private bool showSettings = false;
    private string newPhrase = string.Empty;
    private bool batchMode = false;
    private List<BatchPdfFile> batchFiles = new List<BatchPdfFile>();
    private List<BatchPdfFile> batchStampedFiles = new List<BatchPdfFile>();
    private int currentBatchIndex = 0;
    private BatchPdfFile? currentBatchFile => currentBatchIndex < batchFiles.Count ? batchFiles[currentBatchIndex] : null;
    
	private class BatchPdfFile
	{
		public string Name { get; set; } = "";
		public byte[] OriginalBytes { get; set; } = Array.Empty<byte>();
		public byte[]? StampedBytes { get; set; }
		public int PageCount { get; set; }
		public bool Downloaded { get; set; } = false;  // Add this
	}    
    private string stampText = "CONFIDENTIAL";
    private string stampPosition = "TopRight";
	private int textRotation = 0;
    private int fontSize = 24;
    private string fontFamily = "Arial";
    private string stampColor = "Red";
    private int stampOpacity = 100;
    private bool stampAllPages = true;
    private int pageNumber = 1;
    private bool showBorder = false;
    private string borderStyle = "Single";
    private string borderColor = "Red";
    private int borderWidth = 2;
    private int borderPadding = 10;
    private int cornerRadius = 15;
    private int effectIntensity = 5;
    private int backgroundOpacity = 30;
    private string selectedSymbol = "";
    private string symbolPosition = "Before";
    private int stampsPerPage = 1;
    private string stamp2Position = "BottomLeft";
    private string stamp3Position = "BottomRight";
    private int customX = 50;
    private int customY = 50;
    private int customRotation = 0;
    
    private List<string> stampPhrases = new List<string>
    {
        "CONFIDENTIAL",
        "DRAFT",
        "APPROVED",
        "COPY",
        "VOID",
        "URGENT",
        "FOR REVIEW",
        "FINAL"
    };
    
    private void ToggleSettings()
    {
        showSettings = !showSettings;
    }
    
    private void AddPhrase()
    {
        if (!string.IsNullOrWhiteSpace(newPhrase) && !stampPhrases.Contains(newPhrase))
        {
            stampPhrases.Add(newPhrase);
            SavePhrasesToLocalStorage();
            newPhrase = string.Empty;
        }
    }
    
    private void RemovePhrase(string phrase)
    {
        stampPhrases.Remove(phrase);
        SavePhrasesToLocalStorage();
    }
    
    private async void SavePhrasesToLocalStorage()
    {
        try
        {
            var phrasesJson = System.Text.Json.JsonSerializer.Serialize(stampPhrases);
            await JS.InvokeVoidAsync("localStorage.setItem", "stampPhrases", phrasesJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving phrases: {ex.Message}");
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var phrasesJson = await JS.InvokeAsync<string>("localStorage.getItem", "stampPhrases");
                if (!string.IsNullOrEmpty(phrasesJson))
                {
                    var savedPhrases = System.Text.Json.JsonSerializer.Deserialize<List<string>>(phrasesJson);
                    if (savedPhrases != null && savedPhrases.Any())
                    {
                        stampPhrases = savedPhrases;
                    }
                }
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading data: {ex.Message}");
            }
        }
    }
    
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        pdfLoaded = false;
        stampedPdfBytes = null;
        
        try
        {
            var file = e.File;
            
            if (file.ContentType != "application/pdf")
            {
                errorMessage = "Please select a PDF file.";
                return;
            }
            
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
            originalPdfBytes = memoryStream.ToArray();
            
            using var stream = new MemoryStream(originalPdfBytes);
            using var document = PdfReader.Open(stream, PdfDocumentOpenMode.Import);
            pageCount = document.PageCount;
            
            pdfLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading PDF: {ex.Message}";
        }
    }
    
    private async Task HandleBatchFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        batchFiles.Clear();
        batchStampedFiles.Clear();
        currentBatchIndex = 0;
        
        try
        {
            foreach (var file in e.GetMultipleFiles(20)) // Max 20 files
            {
                if (file.ContentType != "application/pdf")
                {
                    continue; // Skip non-PDF files
                }
                
                using var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
                var pdfBytes = memoryStream.ToArray();
                
                using var stream = new MemoryStream(pdfBytes);
                using var document = PdfReader.Open(stream, PdfDocumentOpenMode.Import);
                
                batchFiles.Add(new BatchPdfFile
                {
                    Name = file.Name,
                    OriginalBytes = pdfBytes,
                    PageCount = document.PageCount
                });
            }
            
            if (!batchFiles.Any())
            {
                errorMessage = "No valid PDF files were selected.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading PDFs: {ex.Message}";
        }
    }
    
    private async Task StampPdf()
    {
        // Determine which PDF to process
        byte[]? pdfToProcess = null;
        
        if (batchMode && currentBatchFile != null)
        {
            pdfToProcess = currentBatchFile.OriginalBytes;
        }
        else if (!batchMode)
        {
            pdfToProcess = originalPdfBytes;
        }
        
        if (pdfToProcess == null) return;
        
        isProcessing = true;
        errorMessage = string.Empty;
        
        try
        {
            byte[] resultBytes = null;
            
            await Task.Run(() =>
            {
                using var inputStream = new MemoryStream(pdfToProcess);
                using var document = PdfReader.Open(inputStream, PdfDocumentOpenMode.Modify);
                
                var pagesToStamp = stampAllPages 
                    ? Enumerable.Range(0, document.PageCount) 
                    : new[] { pageNumber - 1 };
                
                foreach (var pageIndex in pagesToStamp)
                {
                    if (pageIndex < 0 || pageIndex >= document.PageCount) continue;
                    
                    var page = document.Pages[pageIndex];
                    
                    if (stampsPerPage == 2)
                    {
                        ApplyStamp(page, stampPosition);
                        var mirroredPosition = GetMirroredPosition(stampPosition);
                        ApplyStamp(page, mirroredPosition);
                    }
                    else
                    {
                        var positions = new List<string> { stampPosition };
                        if (stampsPerPage >= 2) positions.Add(stamp2Position);
                        if (stampsPerPage >= 3) positions.Add(stamp3Position);
                        
                        foreach (var position in positions)
                        {
                            ApplyStamp(page, position);
                        }
                    }
                }
                
                using var outputStream = new MemoryStream();
                document.Save(outputStream);
                resultBytes = outputStream.ToArray();
            });
            
            // Store result in appropriate location
            if (batchMode && currentBatchFile != null)
            {
                currentBatchFile.StampedBytes = resultBytes;
            }
            else
            {
                stampedPdfBytes = resultBytes;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error stamping PDF: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
    
private async Task DownloadCurrentFile()
{
    if (currentBatchFile?.StampedBytes == null) return;
    
    try
    {
        var fileName = $"stamped_{Path.GetFileNameWithoutExtension(currentBatchFile.Name)}.pdf";
        var base64 = Convert.ToBase64String(currentBatchFile.StampedBytes);
        
        errorMessage = string.Empty;
        
        await JS.InvokeVoidAsync("downloadFile", fileName, base64);
        
        // Mark as downloaded
        currentBatchFile.Downloaded = true;
        
        await Task.Delay(100);
    }
    catch (Exception ex)
    {
        errorMessage = $"Download error: {ex.Message}";
    }
}
    private void NextFile()
    {
        if (currentBatchIndex < batchFiles.Count - 1)
        {
            currentBatchIndex++;
        }
    }
    

	private void ApplyTextWithOrientation(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page)
	{
		var state = gfx.Save();
		
		try
		{
			DrawRotatedText(gfx, lines, font, brush, lineHeight, position, page, textRotation);
		}
		finally
		{
			gfx.Restore(state);
		}
	}    private void DrawHorizontalText(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page)
    {
        var maxWidth = 0.0;
        foreach (var line in lines)
        {
            var lineSize = gfx.MeasureString(line, font);
            if (lineSize.Width > maxWidth)
                maxWidth = lineSize.Width;
        }
        
        var totalHeight = lineHeight * lines.Length;
        var textSize = new XSize(maxWidth, totalHeight);
        
        var point = GetPosition(position, page.Width, page.Height, textSize);
        
        // Apply custom rotation if in custom mode
        if (position == "Custom" && customRotation != 0)
        {
            gfx.TranslateTransform(point.X, point.Y);
            gfx.RotateTransform(customRotation);
            point = new XPoint(0, 0);
        }
        
        if (showBorder)
        {
            DrawBorderEffect(gfx, point, textSize, lines, font);
        }
        
        var currentY = point.Y;
        foreach (var line in lines)
        {
            gfx.DrawString(line, font, brush, new XPoint(point.X, currentY), XStringFormats.TopLeft);
            currentY += lineHeight;
        }
    }
    
	private void DrawRotatedText(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page, double angle)
	{
		var maxWidth = 0.0;
		foreach (var line in lines)
		{
			var lineSize = gfx.MeasureString(line, font);
			if (lineSize.Width > maxWidth)
				maxWidth = lineSize.Width;
		}
		
		var totalHeight = lineHeight * lines.Length;
		var textSize = new XSize(maxWidth, totalHeight);
		
		// Get position accounting for rotation
		var point = GetPosition(position, page.Width, page.Height, textSize, angle);
		
		// Move to position and rotate
		gfx.TranslateTransform(point.X, point.Y);
		gfx.RotateTransform(-angle);
		
		// Draw text centered on rotation point
		var startX = -maxWidth / 2;
		var startY = -totalHeight / 2;
		
		if (showBorder)
		{
			var borderTextSize = new XSize(maxWidth, totalHeight);
			DrawBorderEffect(gfx, new XPoint(startX, startY), borderTextSize, lines, font);
		}
		
		var currentY = startY;
		foreach (var line in lines)
		{
			var lineWidth = gfx.MeasureString(line, font).Width;
			var lineX = startX + (maxWidth - lineWidth) / 2; // Center each line
			gfx.DrawString(line, font, brush, new XPoint(lineX, currentY), XStringFormats.TopLeft);
			currentY += lineHeight;
		}
	}
    private void DrawStackedVerticalText(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page)
    {
        var fullText = string.Join("", lines);
        var charSpacing = fontSize * 1.2;
        var textHeight = fullText.Length * charSpacing;
        var textWidth = fontSize;
        
        var point = GetPosition(position, page.Width, page.Height, new XSize(textWidth, textHeight));
        
        if (showBorder)
        {
            var borderRect = new XRect(point.X - borderPadding, point.Y - borderPadding, 
                textWidth + borderPadding * 2, textHeight + borderPadding * 2);
            var pen = new XPen(GetBrush(borderColor), borderWidth);
            gfx.DrawRectangle(pen, XBrushes.Transparent, borderRect);
        }
        
        var currentY = point.Y;
        foreach (char c in fullText)
        {
            gfx.DrawString(c.ToString(), font, brush, new XPoint(point.X, currentY), XStringFormats.TopLeft);
            currentY += charSpacing;
        }
    }
    
    private void DrawCornerDiagonal(XGraphics gfx, string[] lines, XFont font, XBrush brush, PdfPage page, string corner)
    {
        var fullText = string.Join(" ", lines);
        var textWidth = gfx.MeasureString(fullText, font).Width;
        var textHeight = font.Height;
        
        double angle = 0;
        XPoint startPoint;
        var margin = 40.0; // Margin from edge
        
        switch (corner)
        {
            case "TopLeft":
                // Vertical down from top-left (rotated 90 degrees clockwise)
                angle = 90;
                startPoint = new XPoint(margin + textHeight / 2, margin + textWidth / 2);
                break;
                
            case "TopRight":
                // Vertical down from top-right (rotated 90 degrees clockwise)
                angle = 90;
                startPoint = new XPoint(page.Width - margin - textHeight / 2, margin + textWidth / 2);
                break;
                
            case "BottomLeft":
                // Vertical up from bottom-left (rotated 90 degrees counter-clockwise)
                angle = -90;
                startPoint = new XPoint(margin + textHeight / 2, page.Height - margin - textWidth / 2);
                break;
                
            case "BottomRight":
                // Vertical up from bottom-right (rotated 90 degrees counter-clockwise)
                angle = -90;
                startPoint = new XPoint(page.Width - margin - textHeight / 2, page.Height - margin - textWidth / 2);
                break;
                
            default:
                startPoint = new XPoint(margin, margin);
                break;
        }
        
        gfx.TranslateTransform(startPoint.X, startPoint.Y);
        gfx.RotateTransform(angle);
        
        // Draw text centered on the rotation point
        var offset = -textWidth / 2;
        gfx.DrawString(fullText, font, brush, new XPoint(offset, -textHeight / 2), XStringFormats.TopLeft);
    }
    
    private string PrepareTextWithSymbol()
    {
        if (string.IsNullOrEmpty(selectedSymbol))
            return stampText;
        
        return symbolPosition switch
        {
            "Before" => $"{selectedSymbol} {stampText}",
            "After" => $"{stampText} {selectedSymbol}",
            "Above" => $"{selectedSymbol}\n{stampText}",
            "Below" => $"{stampText}\n{selectedSymbol}",
            _ => stampText
        };
    }
    
    private string GetMirroredPosition(string position)
    {
        return position switch
        {
            "TopLeft" => "BottomRight",
            "TopCenter" => "BottomCenter",
            "TopRight" => "BottomLeft",
            "Center" => "Center",
            "BottomLeft" => "TopRight",
            "BottomCenter" => "TopCenter",
            "BottomRight" => "TopLeft",
            "Custom" => "Custom",
            _ => "BottomRight"
        };
    }
    
    private XBrush GetBrush(string color)
    {
        var baseColor = color switch
        {
            "Red" => XColors.Red,
            "Blue" => XColors.Blue,
            "Green" => XColors.Green,
            "Black" => XColors.Black,
            "Gray" => XColors.Gray,
            "Orange" => XColors.Orange,
            "Purple" => XColors.Purple,
            "Yellow" => XColors.Yellow,
            "White" => XColors.White,
            _ => XColors.Red
        };
        
        // Apply opacity
        var alpha = (byte)(255 * stampOpacity / 100);
        var transparentColor = XColor.FromArgb(alpha, baseColor.R, baseColor.G, baseColor.B);
        return new XSolidBrush(transparentColor);
    }
    
    private void DrawBorderEffect(XGraphics gfx, XPoint point, XSize textSize, string[] lines, XFont font)
    {
        var borderBrush = GetBrush(borderColor);
        var pen = new XPen(borderBrush, borderWidth);
        var rect = new XRect(
            point.X - borderPadding,
            point.Y - borderPadding,
            textSize.Width + (borderPadding * 2),
            textSize.Height + (borderPadding * 2)
        );
        
        switch (borderStyle)
        {
            case "Single":
                gfx.DrawRectangle(pen, XBrushes.Transparent, rect);
                break;
                
            case "Double":
                gfx.DrawRectangle(pen, XBrushes.Transparent, rect);
                var innerRect = new XRect(
                    rect.X + borderWidth * 2,
                    rect.Y + borderWidth * 2,
                    rect.Width - borderWidth * 4,
                    rect.Height - borderWidth * 4
                );
                gfx.DrawRectangle(pen, XBrushes.Transparent, innerRect);
                break;
                
            case "Rounded":
                DrawRoundedRectangle(gfx, pen, rect, cornerRadius);
                break;
                
            case "Outline":
                var outlinePen = new XPen(borderBrush, borderWidth);
                var currentY = point.Y;
                foreach (var line in lines)
                {
                    var textPoint = new XPoint(point.X, currentY);
                    for (int dx = -1; dx <= 1; dx++)
                    {
                        for (int dy = -1; dy <= 1; dy++)
                        {
                            if (dx != 0 || dy != 0)
                            {
                                gfx.DrawString(line, font, borderBrush, 
                                    new XPoint(textPoint.X + dx * borderWidth, textPoint.Y + dy * borderWidth), 
                                    XStringFormats.TopLeft);
                            }
                        }
                    }
                    currentY += font.Height;
                }
                break;
                
            case "Shadow":
                var shadowRect = new XRect(
                    rect.X + effectIntensity,
                    rect.Y + effectIntensity,
                    rect.Width,
                    rect.Height
                );
                var shadowBrush = new XSolidBrush(XColor.FromArgb(128, 0, 0, 0));
                gfx.DrawRectangle(shadowBrush, shadowRect);
                gfx.DrawRectangle(XPens.Transparent, XBrushes.White, rect);
                break;
                
            case "Glow":
                for (int i = effectIntensity; i > 0; i--)
                {
                    var glowRect = new XRect(
                        rect.X - i,
                        rect.Y - i,
                        rect.Width + (i * 2),
                        rect.Height + (i * 2)
                    );
                    var alpha = (byte)(50 / effectIntensity * (effectIntensity - i + 1));
                    var glowColor = GetColorFromBrush(borderBrush);
                    var glowBrush = new XSolidBrush(XColor.FromArgb(alpha, glowColor.R, glowColor.G, glowColor.B));
                    gfx.DrawRectangle(glowBrush, glowRect);
                }
                break;
                
            case "Highlight":
                var bgColor = GetColorFromBrush(borderBrush);
                var highlightBrush = new XSolidBrush(
                    XColor.FromArgb((byte)(255 * backgroundOpacity / 100), bgColor.R, bgColor.G, bgColor.B)
                );
                gfx.DrawRectangle(highlightBrush, rect);
                break;
                
            case "Dashed":
                var dashedPen = new XPen(borderBrush, borderWidth);
                dashedPen.DashStyle = XDashStyle.Dash;
                gfx.DrawRectangle(dashedPen, XBrushes.Transparent, rect);
                break;
        }
    }
    
    private void DrawRoundedRectangle(XGraphics gfx, XPen pen, XRect rect, double radius)
    {
        var path = new XGraphicsPath();
        path.AddArc(rect.X, rect.Y, radius * 2, radius * 2, 180, 90);
        path.AddArc(rect.X + rect.Width - radius * 2, rect.Y, radius * 2, radius * 2, 270, 90);
        path.AddArc(rect.X + rect.Width - radius * 2, rect.Y + rect.Height - radius * 2, radius * 2, radius * 2, 0, 90);
        path.AddArc(rect.X, rect.Y + rect.Height - radius * 2, radius * 2, radius * 2, 90, 90);
        path.CloseFigure();
        gfx.DrawPath(pen, path);
    }
    
    private XColor GetColorFromBrush(XBrush brush)
    {
        return borderColor switch
        {
            "Red" => XColors.Red,
            "Blue" => XColors.Blue,
            "Green" => XColors.Green,
            "Black" => XColors.Black,
            "Gray" => XColors.Gray,
            "Orange" => XColors.Orange,
            "Purple" => XColors.Purple,
            "Yellow" => XColors.Yellow,
            "White" => XColors.White,
            _ => XColors.Red
        };
    }
    
private XPoint GetPosition(string position, double pageWidth, double pageHeight, XSize textSize, double rotation = 0)
{
    const double margin = 20;
    
    // Get the bounding box of rotated text
    var rotatedBounds = GetRotatedTextBounds(textSize, rotation);
    
    if (position == "Custom")
    {
        // Use percentage-based custom position
        var x = margin + (pageWidth - 2 * margin - rotatedBounds.Width) * customX / 100.0;
        var y = margin + (pageHeight - 2 * margin - rotatedBounds.Height) * customY / 100.0;
        
        // Add offset for rotation pivot
        x += rotatedBounds.Width / 2;
        y += rotatedBounds.Height / 2;
        
        return new XPoint(x, y);
    }
    
    XPoint point;
    
    switch (position)
    {
        case "TopLeft":
            point = new XPoint(margin + rotatedBounds.Width / 2, margin + rotatedBounds.Height / 2);
            break;
        case "TopCenter":
            point = new XPoint(pageWidth / 2, margin + rotatedBounds.Height / 2);
            break;
        case "TopRight":
            point = new XPoint(pageWidth - margin - rotatedBounds.Width / 2, margin + rotatedBounds.Height / 2);
            break;
        case "Center":
            point = new XPoint(pageWidth / 2, pageHeight / 2);
            break;
        case "BottomLeft":
            point = new XPoint(margin + rotatedBounds.Width / 2, pageHeight - margin - rotatedBounds.Height / 2);
            break;
        case "BottomCenter":
            point = new XPoint(pageWidth / 2, pageHeight - margin - rotatedBounds.Height / 2);
            break;
        case "BottomRight":
            point = new XPoint(pageWidth - margin - rotatedBounds.Width / 2, pageHeight - margin - rotatedBounds.Height / 2);
            break;
        default:
            point = new XPoint(margin + rotatedBounds.Width / 2, margin + rotatedBounds.Height / 2);
            break;
    }
    
    return point;
}
    
    private string GetPdfDataUrl(byte[] pdfBytes)
    {
        if (pdfBytes == null || pdfBytes.Length == 0)
        {
            return "about:blank";
        }
        
        try
        {
            var base64 = Convert.ToBase64String(pdfBytes);
            return $"data:application/pdf;base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating PDF data URL: {ex.Message}");
            return "about:blank";
        }
    }
    
    private async Task DownloadStampedPdf()
    {
        if (stampedPdfBytes == null) return;
        
        try
        {
            var fileName = $"stamped_{DateTime.Now:yyyyMMddHHmmss}.pdf";
            var base64 = Convert.ToBase64String(stampedPdfBytes);
            
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Download error: {ex.Message}";
        }
    }
    
private async Task DownloadAllCompleted()
{
    try
    {
        // Only download files that are stamped but haven't been downloaded yet
        var filesToDownload = batchFiles.Where(f => f.StampedBytes != null && !f.Downloaded).ToList();
        
        if (!filesToDownload.Any())
        {
            errorMessage = "All files have already been downloaded!";
            return;
        }
        
        for (int i = 0; i < filesToDownload.Count; i++)
        {
            var file = filesToDownload[i];
            var fileName = $"stamped_{Path.GetFileNameWithoutExtension(file.Name)}.pdf";
            var base64 = Convert.ToBase64String(file.StampedBytes!);
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
            
            // Mark as downloaded
            file.Downloaded = true;
            
            // Longer delay between downloads
            if (i < filesToDownload.Count - 1)
            {
                await Task.Delay(1000);
            }
        }
        
        errorMessage = $"Downloaded {filesToDownload.Count} file(s) successfully!";
    }
    catch (Exception ex)
    {
        errorMessage = $"Download error: {ex.Message}";
    }
}
private void ApplyStamp(PdfPage page, string position)
{
    using var gfx = XGraphics.FromPdfPage(page);
    
    var font = new XFont(fontFamily, fontSize, XFontStyle.Bold);
    var brush = GetBrush(stampColor);
    
    // Prepare text with symbol
    var fullText = PrepareTextWithSymbol();
    
    var lines = fullText.Replace("\\n", "\n").Split('\n');
    var lineHeight = font.Height;
    
    // Apply text with rotation
    ApplyTextWithOrientation(gfx, lines, font, brush, lineHeight, position, page);
}
private XRect GetRotatedTextBounds(XSize textSize, double angle)
{
    // Convert angle to radians
    var rad = angle * Math.PI / 180.0;
    
    // Calculate the four corners of the text rectangle after rotation
    var cos = Math.Abs(Math.Cos(rad));
    var sin = Math.Abs(Math.Sin(rad));
    
    // New bounding box dimensions
    var width = textSize.Width * cos + textSize.Height * sin;
    var height = textSize.Width * sin + textSize.Height * cos;
    
    return new XRect(0, 0, width, height);
}
