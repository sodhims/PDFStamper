	private void ApplyStamp(PdfPage page, string position)
	{
		using var gfx = XGraphics.FromPdfPage(page);
		
		// Calculate position first
		double centerX, centerY;
		const double margin = 30;
		
		// Get center point based on position
		switch (position)
		{
			case "TopLeft":
				centerX = margin + 50;
				centerY = margin + 50;
				break;
			case "TopRight":
				centerX = page.Width - margin - 50;
				centerY = margin + 50;
				break;
			case "TopCenter":
				centerX = page.Width / 2;
				centerY = margin + 50;
				break;
			case "BottomLeft":
				centerX = margin + 50;
				centerY = page.Height - margin - 50;
				break;
			case "BottomRight":
				centerX = page.Width - margin - 50;
				centerY = page.Height - margin - 50;
				break;
			case "BottomCenter":
				centerX = page.Width / 2;
				centerY = page.Height - margin - 50;
				break;
			case "Center":
			default:
				centerX = page.Width / 2;
				centerY = page.Height / 2;
				break;
		}
		
		var state = gfx.Save();
		
		// Apply rotation at the center point
		gfx.TranslateTransform(centerX, centerY);
		gfx.RotateTransform(textRotation);
		
		double currentY = 0;
		
		// Draw image if mode allows
		if (stampImageBytes != null && (stampMode == "ImageOnly" || stampMode == "Both"))
		{
			var image = XImage.FromStream(() => new MemoryStream(stampImageBytes));
			var aspectRatio = (double)image.PixelHeight / image.PixelWidth;
			var imgHeight = imageWidth * aspectRatio;
			
			// Draw image centered at origin (which is now the rotation point)
			gfx.DrawImage(image, -imageWidth / 2, currentY - imgHeight / 2, imageWidth, imgHeight);
			
			if (stampMode == "Both")
			{
				currentY += imgHeight / 2 + 10; // Add spacing before text
			}
		}
		
		// Draw text if mode allows
		if (!string.IsNullOrEmpty(stampText) && (stampMode == "TextOnly" || stampMode == "Both"))
		{
			var font = new XFont(fontFamily, fontSize, XFontStyle.Bold);
			var brush = GetBrush(stampColor);
			var fullText = PrepareTextWithSymbol();
			var lines = fullText.Replace("\\n", "\n").Split('\n');
			
			// Calculate total text height
			var totalHeight = lines.Length * font.Height;
			var startY = stampMode == "Both" ? currentY : -totalHeight / 2;
			
			// Draw each line centered
			foreach (var line in lines)
			{
				var lineSize = gfx.MeasureString(line, font);
				gfx.DrawString(line, font, brush, -lineSize.Width / 2, startY, XStringFormats.TopLeft);
				startY += font.Height;
			}
		}
		
		gfx.Restore(state);
	}    
    private XPoint GetImagePosition(string position, double pageWidth, double pageHeight, double imgWidth, double imgHeight)
    {
        const double margin = 30;
        
        return position switch
        {
            "TopLeft" => new XPoint(margin, margin),
            "TopRight" => new XPoint(pageWidth - imgWidth - margin, margin),
            "TopCenter" => new XPoint((pageWidth - imgWidth) / 2, margin),
            "BottomLeft" => new XPoint(margin, pageHeight - imgHeight - margin),
            "BottomRight" => new XPoint(pageWidth - imgWidth - margin, pageHeight - imgHeight - margin),
            "BottomCenter" => new XPoint((pageWidth - imgWidth) / 2, pageHeight - imgHeight - margin),
            "Center" => new XPoint((pageWidth - imgWidth) / 2, (pageHeight - imgHeight) / 2),
            _ => new XPoint(margin, margin)
        };
    }
    
    private void ApplyTextWithOrientation(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page)
    {
        var state = gfx.Save();
        
        try
        {
            DrawRotatedText(gfx, lines, font, brush, lineHeight, position, page, textRotation);
        }
        finally
        {
            gfx.Restore(state);
        }
    }
    
    private XRect GetRotatedTextBounds(XSize textSize, double angle)
    {
        var rad = angle * Math.PI / 180.0;
        
        var cos = Math.Abs(Math.Cos(rad));
        var sin = Math.Abs(Math.Sin(rad));
        
        var width = textSize.Width * cos + textSize.Height * sin;
        var height = textSize.Width * sin + textSize.Height * cos;
        
        return new XRect(0, 0, width, height);
    }
    
    private void DrawRotatedText(XGraphics gfx, string[] lines, XFont font, XBrush brush, double lineHeight, string position, PdfPage page, double angle)
    {
        var maxWidth = 0.0;
        var totalHeight = 0.0;
        
        foreach (var line in lines)
        {
            var lineSize = gfx.MeasureString(line, font);
            if (lineSize.Width > maxWidth)
                maxWidth = lineSize.Width;
        }
        totalHeight = lineHeight * lines.Length;
        
        var textSize = new XSize(maxWidth, totalHeight);
        var point = GetPosition(position, page.Width, page.Height, textSize, angle);
        
        gfx.TranslateTransform(point.X, point.Y);
        gfx.RotateTransform(angle);
        
        var startX = -maxWidth / 2;
        var startY = -totalHeight / 2;
        
        if (showBorder)
        {
            var borderTextSize = new XSize(maxWidth, totalHeight);
            DrawBorderEffect(gfx, new XPoint(startX, startY), borderTextSize, lines, font);
        }
        
        var currentY = startY;
        
        foreach (var line in lines)
        {
            var lineWidth = gfx.MeasureString(line, font).Width;
            var lineX = startX + (maxWidth - lineWidth) / 2;
            gfx.DrawString(line, font, brush, new XPoint(lineX, currentY), XStringFormats.TopLeft);
            currentY += lineHeight;
        }
    }
    
    private string PrepareTextWithSymbol()
    {
        var mainText = stampText;
        
        if (!string.IsNullOrEmpty(selectedSymbol))
        {
            mainText = symbolPosition switch
            {
                "Before" => $"{selectedSymbol} {stampText}",
                "After" => $"{stampText} {selectedSymbol}",
                "Above" => $"{selectedSymbol}\n{stampText}",
                "Below" => $"{stampText}\n{selectedSymbol}",
                _ => stampText
            };
        }
        
        if (includeDateTimeStamp)
        {
            var dateTimeText = DateTime.Now.ToString(dateTimeFormat);
            
            mainText = dateTimePosition switch
            {
                "Above" => $"{dateTimeText}\n{mainText}",
                "Below" => $"{mainText}\n{dateTimeText}",
                "Replace" => dateTimeText,
                _ => mainText
            };
        }
        
        return mainText;
    }
    
    private string GetMirroredPosition(string position)
    {
        return position switch
        {
            "TopLeft" => "BottomRight",
            "TopCenter" => "BottomCenter",
            "TopRight" => "BottomLeft",
            "Center" => "Center",
            "BottomLeft" => "TopRight",
            "BottomCenter" => "TopCenter",
            "BottomRight" => "TopLeft",
            _ => "BottomRight"
        };
    }
    
    private XBrush GetBrush(string color)
    {
        var baseColor = color switch
        {
            "Red" => XColors.Red,
            "Blue" => XColors.Blue,
            "Green" => XColors.Green,
            "Black" => XColors.Black,
            "Gray" => XColors.Gray,
            "Orange" => XColors.Orange,
            "Purple" => XColors.Purple,
            "Yellow" => XColors.Yellow,
            "White" => XColors.White,
            _ => XColors.Red
        };
        
        var alpha = (byte)(255 * stampOpacity / 100);
        var transparentColor = XColor.FromArgb(alpha, baseColor.R, baseColor.G, baseColor.B);
        return new XSolidBrush(transparentColor);
    }
    
    private void DrawBorderEffect(XGraphics gfx, XPoint point, XSize textSize, string[] lines, XFont font)
    {
        var borderBrush = GetBrush(borderColor);
        var pen = new XPen(borderBrush, borderWidth);
        var rect = new XRect(
            point.X - borderPadding,
            point.Y - borderPadding,
            textSize.Width + (borderPadding * 2),
            textSize.Height + (borderPadding * 2)
        );
        
        switch (borderStyle)
        {
            case "Single":
                gfx.DrawRectangle(pen, XBrushes.Transparent, rect);
                break;
                
            case "Double":
                gfx.DrawRectangle(pen, XBrushes.Transparent, rect);
                var innerRect = new XRect(
                    rect.X + borderWidth * 2,
                    rect.Y + borderWidth * 2,
                    rect.Width - borderWidth * 4,
                    rect.Height - borderWidth * 4
                );
                gfx.DrawRectangle(pen, XBrushes.Transparent, innerRect);
                break;
                
            case "Rounded":
                DrawRoundedRectangle(gfx, pen, rect, 10);
                break;
                
            case "Shadow":
                var shadowRect = new XRect(
                    rect.X + 3,
                    rect.Y + 3,
                    rect.Width,
                    rect.Height
                );
                var shadowBrush = new XSolidBrush(XColor.FromArgb(128, 0, 0, 0));
                gfx.DrawRectangle(shadowBrush, shadowRect);
                gfx.DrawRectangle(XPens.Transparent, XBrushes.White, rect);
                break;
        }
    }
    
    private void DrawRoundedRectangle(XGraphics gfx, XPen pen, XRect rect, double radius)
    {
        var path = new XGraphicsPath();
        path.AddArc(rect.X, rect.Y, radius * 2, radius * 2, 180, 90);
        path.AddArc(rect.X + rect.Width - radius * 2, rect.Y, radius * 2, radius * 2, 270, 90);
        path.AddArc(rect.X + rect.Width - radius * 2, rect.Y + rect.Height - radius * 2, radius * 2, radius * 2, 0, 90);
        path.AddArc(rect.X, rect.Y + rect.Height - radius * 2, radius * 2, radius * 2, 90, 90);
        path.CloseFigure();
        gfx.DrawPath(pen, path);
    }
    
    private XColor GetColorFromBrush(XBrush brush)
    {
        return borderColor switch
        {
            "Red" => XColors.Red,
            "Blue" => XColors.Blue,
            "Green" => XColors.Green,
            "Black" => XColors.Black,
            "Gray" => XColors.Gray,
            "Orange" => XColors.Orange,
            "Purple" => XColors.Purple,
            "Yellow" => XColors.Yellow,
            "White" => XColors.White,
            _ => XColors.Red
        };
    }
    
    private XPoint GetPosition(string position, double pageWidth, double pageHeight, XSize textSize, double rotation = 0)
    {
        const double margin = 30;
        
        var rotatedBounds = GetRotatedTextBounds(textSize, rotation);
        var safeMargin = Math.Max(margin, Math.Max(rotatedBounds.Width, rotatedBounds.Height) / 2 + 10);
        
        XPoint point;
        
        switch (position)
        {
            case "TopLeft":
                point = new XPoint(safeMargin, safeMargin);
                break;
            case "TopCenter":
                point = new XPoint(pageWidth / 2, safeMargin);
                break;
            case "TopRight":
                point = new XPoint(pageWidth - safeMargin, safeMargin);
                break;
            case "Center":
                point = new XPoint(pageWidth / 2, pageHeight / 2);
                break;
            case "BottomLeft":
                point = new XPoint(safeMargin, pageHeight - safeMargin);
                break;
            case "BottomCenter":
                point = new XPoint(pageWidth / 2, pageHeight - safeMargin);
                break;
            case "BottomRight":
                point = new XPoint(pageWidth - safeMargin, pageHeight - safeMargin);
                break;
            default:
                point = new XPoint(safeMargin, safeMargin);
                break;
        }
        
        return point;
    }
    
    private string GetPdfDataUrl(byte[] pdfBytes)
    {
        if (pdfBytes == null || pdfBytes.Length == 0)
        {
            return "about:blank";
        }
        
        try
        {
            var base64 = Convert.ToBase64String(pdfBytes);
            return $"data:application/pdf;base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating PDF data URL: {ex.Message}");
            return "about:blank";
        }
    }
    
    private async Task DownloadStampedPdf()
    {
        if (stampedPdfBytes == null) return;
        
        try
        {
            var fileName = $"stamped_{DateTime.Now:yyyyMMddHHmmss}.pdf";
            var base64 = Convert.ToBase64String(stampedPdfBytes);
            await JS.InvokeVoidAsync("downloadFile", fileName, base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Download error: {ex.Message}";
        }
    }
    
    private async Task DownloadAsZip()
    {
        try
        {
            var completedFiles = batchFiles.Where(f => f.StampedBytes != null).ToList();
            
            if (!completedFiles.Any())
            {
                errorMessage = "No stamped files to download.";
                return;
            }
            
            using var zipStream = new MemoryStream();
            var files = new List<(string name, byte[] data, uint crc)>();
            
            foreach (var file in completedFiles)
            {
                var fileName = $"stamped_{Path.GetFileNameWithoutExtension(file.Name)}.pdf";
                var crc = CalculateCrc32(file.StampedBytes!);
                files.Add((fileName, file.StampedBytes!, crc));
            }
            
            var centralDirectory = new List<byte[]>();
            uint offset = 0;
            
            foreach (var (name, data, crc) in files)
            {
                var nameBytes = System.Text.Encoding.UTF8.GetBytes(name);
                
                var localHeader = new List<byte>();
                localHeader.AddRange(new byte[] { 0x50, 0x4b, 0x03, 0x04 });
                localHeader.AddRange(BitConverter.GetBytes((ushort)20));
                localHeader.AddRange(BitConverter.GetBytes((ushort)0));
                localHeader.AddRange(BitConverter.GetBytes((ushort)0));
                localHeader.AddRange(BitConverter.GetBytes((ushort)0));
                localHeader.AddRange(BitConverter.GetBytes((ushort)0));
                localHeader.AddRange(BitConverter.GetBytes(crc));
                localHeader.AddRange(BitConverter.GetBytes(data.Length));
                localHeader.AddRange(BitConverter.GetBytes(data.Length));
                localHeader.AddRange(BitConverter.GetBytes((ushort)nameBytes.Length));
                localHeader.AddRange(BitConverter.GetBytes((ushort)0));
                localHeader.AddRange(nameBytes);
                
                await zipStream.WriteAsync(localHeader.ToArray(), 0, localHeader.Count);
                await zipStream.WriteAsync(data, 0, data.Length);
                
                var centralEntry = new List<byte>();
                centralEntry.AddRange(new byte[] { 0x50, 0x4b, 0x01, 0x02 });
                centralEntry.AddRange(BitConverter.GetBytes((ushort)20));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)20));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes(crc));
                centralEntry.AddRange(BitConverter.GetBytes(data.Length));
                centralEntry.AddRange(BitConverter.GetBytes(data.Length));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)nameBytes.Length));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((ushort)0));
                centralEntry.AddRange(BitConverter.GetBytes((uint)0));
                centralEntry.AddRange(BitConverter.GetBytes(offset));
                centralEntry.AddRange(nameBytes);
                
                centralDirectory.Add(centralEntry.ToArray());
                offset += (uint)(localHeader.Count + data.Length);
            }
            
            var centralDirOffset = offset;
            var centralDirSize = 0;
            foreach (var entry in centralDirectory)
            {
                await zipStream.WriteAsync(entry, 0, entry.Length);
                centralDirSize += entry.Length;
            }
            
            var endRecord = new List<byte>();
            endRecord.AddRange(new byte[] { 0x50, 0x4b, 0x05, 0x06 });
            endRecord.AddRange(BitConverter.GetBytes((ushort)0));
            endRecord.AddRange(BitConverter.GetBytes((ushort)0));
            endRecord.AddRange(BitConverter.GetBytes((ushort)files.Count));
            endRecord.AddRange(BitConverter.GetBytes((ushort)files.Count));
            endRecord.AddRange(BitConverter.GetBytes(centralDirSize));
            endRecord.AddRange(BitConverter.GetBytes(centralDirOffset));
            endRecord.AddRange(BitConverter.GetBytes((ushort)0));
            
            await zipStream.WriteAsync(endRecord.ToArray(), 0, endRecord.Count);
            
            var zipBytes = zipStream.ToArray();
            var base64 = Convert.ToBase64String(zipBytes);
            var zipFileName = $"stamped_pdfs_{DateTime.Now:yyyyMMddHHmmss}.zip";
            
            await JS.InvokeVoidAsync("downloadFile", zipFileName, base64);
            
            errorMessage = $"Downloaded {completedFiles.Count} file(s) as ZIP successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"ZIP download error: {ex.Message}";
        }
    }
    
    private uint CalculateCrc32(byte[] data)
    {
        uint crc = 0xFFFFFFFF;
        
        for (int i = 0; i < data.Length; i++)
        {
            byte index = (byte)(((crc) & 0xFF) ^ data[i]);
            crc = (crc >> 8) ^ Crc32Table[index];
        }
        
        return ~crc;
    }
    
