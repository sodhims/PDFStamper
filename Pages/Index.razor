    private string GetPreviewFontFamily()
    {
        return fontFamily;
    }
    
    private string GetColorCode(string colorName)
    {
        return colorName switch
        {
            "Red" => "#FF0000",
            "Blue" => "#0000FF",
            "Green" => "#008000",
            "Black" => "#000000",
            "Gray" => "#808080",
            "Orange" => "#FFA500",
            "Purple" => "#800080",
            "Yellow" => "#FFFF00",
            "White" => "#FFFFFF",
            _ => "#FF0000"
        };
    }
    
    private void RotateClockwise()
    {
        textRotation += 45;
        if (textRotation > 180)
            textRotation -= 360;
    }
    
    private void RotateCounterClockwise()
    {
        textRotation -= 45;
        if (textRotation < -180)
            textRotation += 360;
    }
    
    private void ResetRotation()
    {
        textRotation = 0;
    }
    
    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            
            if (file.Size > 5 * 1024 * 1024)
            {
                errorMessage = "Image must be less than 5MB";
                return;
            }
            
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
            stampImageBytes = memoryStream.ToArray();
            stampImageName = file.Name;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading image: {ex.Message}";
        }
    }
    
    private void ClearImage()
    {
        stampImageBytes = null;
        stampImageName = string.Empty;
    }
    
    private string GetImageDataUrl()
    {
        if (stampImageBytes == null || stampImageBytes.Length == 0)
        {
            return string.Empty;
        }
        
        try
        {
            var base64 = Convert.ToBase64String(stampImageBytes);
            var extension = Path.GetExtension(stampImageName).ToLower();
            var mimeType = extension switch
            {
                ".png" => "image/png",
                ".jpg" or ".jpeg" => "image/jpeg",
                _ => "image/png"
            };
            return $"data:{mimeType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating image data URL: {ex.Message}");
            return string.Empty;
        }
    }
